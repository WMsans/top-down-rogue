// Walkability enforcement — ensures every chunk has a contiguous air pocket
// with inscribed-disk radius >= 75 pixels.
//
// Steps:
//   1. strip-pools: revert pool-deposited cells near argmax to AIR
//   2. re-run JFA to recompute radius
//   3. dilate: iteratively carve solid cells to grow the largest air pocket
//   4. after each dilate, re-run JFA to recompute radius
//   5. cap at 30 iterations (idempotent once max_radius >= 75)

const int WALKABILITY_TARGET_RADIUS = 75;

// Strip pool-origin cells within the largest pocket region.
// If max_radius < 75, cells with alpha bit 7 set (pool-origin) near the
// argmax are reverted to MAT_AIR.
void stage_walkability_strip_pools(ivec2 pos) {
    int packed = chunk_max.max_radius_packed;
    int max_r = packed >> 16;
    if (max_r >= WALKABILITY_TARGET_RADIUS) return;
    int cx = (packed >> 8) & 0xFF;
    int cy = packed & 0xFF;
    int range = max_r + 80;
    if (max(abs(pos.x - cx), abs(pos.y - cy)) > range) return;

    vec4 cur = imageLoad(chunk_tex, pos);
    int alpha = int(round(cur.a * 255.0));
    bool was_pool = (alpha & 0x80) != 0;
    if (!was_pool) return;

    imageStore(chunk_tex, pos, vec4(0.0, 0.0, 0.0, float(alpha & 0x7F) / 255.0));
}

// Dilate: carve solid cells within the pocket-bounded region that have
// a "reachable air" neighbor (air with inscribed radius >= 1).
// This grows the dominant pocket one layer per iteration.
void stage_walkability_dilate(ivec2 pos) {
    int packed = chunk_max.max_radius_packed;
    int max_r = packed >> 16;
    if (max_r >= WALKABILITY_TARGET_RADIUS) return;
    int cx = (packed >> 8) & 0xFF;
    int cy = packed & 0xFF;
    int range = 75 + 30;
    if (max(abs(pos.x - cx), abs(pos.y - cy)) > range) return;

    vec4 cur = imageLoad(chunk_tex, pos);
    int mat = int(round(cur.r * 255.0));
    if (mat == MAT_AIR) return;

    bool has_reachable_air = false;
    for (int d = 0; d < 4; d++) {
        ivec2 n = pos;
        if (d == 0) n.x -= 1;
        else if (d == 1) n.x += 1;
        else if (d == 2) n.y -= 1;
        else n.y += 1;
        if (n.x < 0 || n.x >= 256 || n.y < 0 || n.y >= 256) continue;
        vec4 ncur = imageLoad(chunk_tex, n);
        int nmat = int(round(ncur.r * 255.0));
        int nrad = int(round(ncur.a * 255.0)) & 0x7F;
        if (nmat == MAT_AIR && nrad >= 1) {
            has_reachable_air = true;
            break;
        }
    }

    if (has_reachable_air) {
        imageStore(chunk_tex, pos, vec4(0.0, 0.0, 0.0, 0.0));
    }
}
